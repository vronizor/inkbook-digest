READER_TOKEN=
READER_TAG_TRIGGER=toepub
READER_TAG_DONE=sent-to-inkbook

SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=digest@vinceth.net

ALERT_EMAIL=

DIGEST_HOUR=6
DIGEST_MINUTE=30
TZ=Europe/Paris

IMAGE_SOFT_CAP_MB=10
DATA_DIR=/data
LOG_LEVEL=INFO

WORD_BUDGET=5000

LIBRARY_MAX_UPLOAD_MB=200
EPUB_RETENTION_DAYS=0
BASE_URL=

# Other OPDS catalogs to list in the root feed, as Title|URL pairs separated by ;
# EXTRA_CATALOGS=Telex Weekly|https://telex.your-tailnet.ts.net/opds/
EXTRA_CATALOGS=

# Email subscribers (managed from the dashboard). Only articles also tagged SHARE_TAG
# are emailed; set SHARE_TAG= (empty) to share every article in the digest.
SHARE_TAG=toshare
SHARE_SENDER_NAME=Morning Paper
SHARE_REPLY_TO=
